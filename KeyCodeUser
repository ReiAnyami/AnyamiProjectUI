-- Функция активации
local function Activate()
    local key = string.upper(KeyInput.Text:gsub("%s+", ""))

    if key == "" then
        Status.Text = "❌ Enter a license key!"
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        -- Анимация ошибки
        KeyInput.BackgroundColor3 = Color3.fromRGB(55, 35, 35)
        task.wait(0.3)
        KeyInput.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        return
    end

    Status.Text = "🔄 Verifying license..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    -- Блокируем кнопку и показываем анимацию
    Btn.Visible = false
    LoadingCircle.Visible = true
    
    -- Анимация вращения
    local spinTween = TweenService:Create(LoadingCircle, TweenInfo.new(0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, true), {
        Rotation = 360
    })
    spinTween:Play()
    
    local valid, sub = ValidateKey(key, userUID)

    if valid then
        Status.Text = "✅ Activated successfully! (" .. sub .. ")"
        Status.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        spinTween:Cancel()
        LoadingCircle.Visible = false
        Btn.Visible = true

        pcall(function()
            if writefile then
                writefile("AnyamiLicense.dat", key)
            end
        end)

        -- Анимация успеха
        local successTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 540, 0, 460)
        })
        successTween:Play()
        
        task.wait(1.2)

        local cheat = LoadCheat()
        if cheat then
            -- Плавное исчезновение
            local fadeTween = TweenService:Create(ScreenGui, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1
            })
            fadeTween:Play()
            task.wait(0.4)
            
            ScreenGui:Destroy()
            cheat()
        else
            Status.Text = "❌ Failed to load cheat!"
            Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    else
        Status.Text = "❌ " .. sub
        Status.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        spinTween:Cancel()
        LoadingCircle.Visible = false
        Btn.Visible = true
        
        -- Анимация ошибки на поле ввода
        KeyInput.BackgroundColor3 = Color3.fromRGB(55, 35, 35)
        task.wait(0.3)
        KeyInput.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    end
end

