local function AnimateButton(button)
    local TweenInfoObj = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    local hoverIn = TweenService:Create(button, TweenInfoObj, {
        BackgroundColor3 = Color3.fromRGB(220, 70, 70),
        Size = UDim2.new(0, 210, 0, 48)
    })
    
    local hoverOut = TweenService:Create(button, TweenInfoObj, {
        BackgroundColor3 = Color3.fromRGB(255, 80, 80),
        Size = UDim2.new(0, 200, 0, 45)
    })
    
    button.MouseEnter:Connect(function()
        hoverIn:Play()
    end)
    
    button.MouseLeave:Connect(function()
        hoverOut:Play()
    end)
end

local function AnimateFrame(frame)
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0.5, -250, 0.5, -250)
    
    local tween = TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -250, 0.5, -200),
        BackgroundTransparency = 0
    })
    tween:Play()
end

