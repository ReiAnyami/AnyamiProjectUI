-- ╔══════════════════════════════════════════╗
-- ║          АКТИВАЦИЯ                      ║
-- ╚══════════════════════════════════════════╝
local function Activate()
    local key = string.upper(KeyInput.Text:gsub("%s+", ""))

    if key == "" then
        Status.Text = "Введите ключ!"
        return
    end

    Status.Text = "Проверка..."
    
    local valid, sub = ValidateKey(key, userUID)

    if valid then
        Status.Text = "Успешно! ("..sub..")"

        pcall(function()
            if writefile then
                writefile("AnyamiLicense.dat", key)
            end
        end)

        task.wait(1)

        local cheat = LoadCheat()
        if cheat then
            ScreenGui:Destroy()
            cheat()
        else
            Status.Text = "Ошибка загрузки!"
        end
    else
        Status.Text = sub
    end
end

Btn.MouseButton1Click:Connect(Activate)

KeyInput.FocusLost:Connect(function(enter)
    if enter then
        Activate()
    end
end)

print("ANYAMI LOADED | UID:", userUID)
