-- ╔══════════════════════════════════════════╗
-- ║              UID                         ║
-- ╚══════════════════════════════════════════╝
local function GetUID()
    local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
    
    local userId = player.UserId
    local platform = "Unknown"
    local hwid = "none"

    pcall(function()
        platform = game:GetService("UserInputService"):GetPlatform()
    end)

    pcall(function()
        local res = game:GetService("GuiService"):GetScreenResolution()
        if res then
            hwid = tostring(res.X) .. "x" .. tostring(res.Y)
        end
    end)

    return tostring(userId) .. "_" .. tostring(platform) .. "_" .. hwid
end

-- ╔══════════════════════════════════════════╗
-- ║          ЗАГРУЗКА КЛЮЧЕЙ                ║
-- ╚══════════════════════════════════════════╝
local function LoadKeys()
    local success, data = pcall(function()
        return game:HttpGet(KeysURL)
    end)

    if success and data then
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(data)
        end)

        if ok and decoded then
            return decoded
        end
    end

    return nil
end

-- ╔══════════════════════════════════════════╗
-- ║          ПРОВЕРКА КЛЮЧА                 ║
-- ╚══════════════════════════════════════════╝
local function ValidateKey(key, userUID)
    local keys = LoadKeys()
    if not keys then
        return false, "Ошибка загрузки ключей!"
    end
    
    if keys[key] then
        local keyData = keys[key]

        if keyData.expiry and keyData.expiry > os.time() then
            if keyData.hwid ~= "" and keyData.hwid ~= userUID then
                return false, "Ключ уже привязан к другому устройству!"
            end
            return true, keyData.subscription or "Unknown", keyData.expiry
        else
            return false, "Ключ истек!"
        end
    end

    return false, "Неверный ключ!"
end

-- ╔══════════════════════════════════════════╗
-- ║          ЗАГРУЗКА ЧИТА                  ║
-- ╚══════════════════════════════════════════╝
local function LoadCheat()
    local success, cheatCode = pcall(function()
        return game:HttpGet(CheatURL)
    end)

    if success and cheatCode then
        if not loadstring then
            warn("loadstring недоступен")
            return nil
        end

        local func, err = loadstring(cheatCode)
        if func then
            return func
        else
            warn("Ошибка: " .. tostring(err))
        end
    end

    return nil
end

