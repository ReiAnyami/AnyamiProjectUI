local function AimAt(bone, character)
    if not bone then return end
    local targetPos = bone.Position
    if Config.Aimbot.Prediction > 0 then
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            targetPos = targetPos + root.AssemblyLinearVelocity * Config.Aimbot.Prediction
        end
    end
    local dir = (targetPos - Camera.CFrame.Position).Unit
    local dot = Camera.CFrame.LookVector:Dot(dir)
    local angleFactor = math.clamp(1 - dot, 0, 1)
    local smooth = Config.Aimbot.Smoothness * (0.4 + 0.6 * angleFactor)
    smooth = math.clamp(smooth, 0.01, 1)
    local targetCF = CFrame.new(Camera.CFrame.Position, targetPos)
    Camera.CFrame = Camera.CFrame:Lerp(targetCF, smooth)
end

local function UpdateAimbot()
    if not Config.Aimbot.Enabled or not State.Aiming then
        State.AimTarget = nil
        State.CurrentTarget = nil
        if State.AutoFiring then
            pcall(InputManager.Release)
            State.AutoFiring = false
        end
        return
    end

    local mousePos
    if Config.Aimbot.FOVOrigin == "Center" then
        local vp = Camera.ViewportSize
        mousePos = Vector2.new(vp.X / 2, vp.Y / 2)
    else
        mousePos = UserInputService:GetMouseLocation()
    end
    State.CurrentTarget = nil

    if Config.Aimbot.TargetLock and State.AimTarget then
        local t = State.AimTarget
        if IsAlive(t) and IsEnemyFor(t, "Aimbot") and IsInRange(t, Config.Aimbot.MaxDistance) then
            local bone = GetBone(t.Character, Config.Aimbot.Bone)
            if bone then
                local pos, vis = Camera:WorldToViewportPoint(bone.Position)
                if vis then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist <= Config.Aimbot.FOV * 1.5 then
                        if not Config.Aimbot.WallCheck or CheckVisibility(t.Character, true) then
                            State.CurrentTarget = t
                            AimAt(bone, t.Character)
                            if Config.Aimbot.AutoFire and not State.AutoFiring then
                                State.AutoFiring = true
                                pcall(InputManager.Press)
                            end
                            return
                        end
                    end
                end
            end
        end
        State.AimTarget = nil
    end

    local closest, minDist = nil, Config.Aimbot.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) and IsEnemyFor(plr, "Aimbot") and IsInRange(plr, Config.Aimbot.MaxDistance) then
            if not Config.Aimbot.WallCheck or CheckVisibility(plr.Character, true) then
                local bone = GetBone(plr.Character, Config.Aimbot.Bone)
                if bone then
                    local pos, vis = Camera:WorldToViewportPoint(bone.Position)
                    if vis then
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closest = plr
                        end
                    end
                end
            end
        end
    end

    if closest then
        if Config.Aimbot.TargetLock then State.AimTarget = closest end
        State.CurrentTarget = closest
        local bone = GetBone(closest.Character, Config.Aimbot.Bone)
        AimAt(bone, closest.Character)
        if Config.Aimbot.AutoFire and not State.AutoFiring then
            State.AutoFiring = true
            pcall(InputManager.Press)
        end
    else
        if State.AutoFiring then
            pcall(InputManager.Release)
            State.AutoFiring = false
        end
    end
end

