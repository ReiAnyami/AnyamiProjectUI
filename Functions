-- ║                            TRIGGERBOT                                 ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local function UpdateTrigger()
    MagnetCircle.Visible = Config.Trigger.Enabled
    MagnetCircle.Position = UserInputService:GetMouseLocation()
    MagnetCircle.Radius = Config.Trigger.MagnetRadius

    if not Config.Trigger.Enabled then
        if State.IsFiring then
            pcall(InputManager.Release)
            State.IsFiring = false
        end
        return
    end

    if Config.Aimbot.AutoFire and Config.Aimbot.Enabled then return end

    local isActive = false
    if Config.Trigger.Mode == "Hold" then
        isActive = IsBindActive(Config.Trigger.Bind)
    else
        isActive = State.ToggleState
    end

    if not isActive then
        if State.IsFiring then
            pcall(InputManager.Release)
            State.IsFiring = false
        end
        return
    end

    local mousePos = UserInputService:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) and IsEnemyFor(plr, "Trigger") then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist <= Config.Trigger.MagnetRadius then
                        if CheckVisibility(plr.Character, head) then
                            State.LastTargetT = tick()
                            break
                        end
                    end
                end
            end
        end
    end

    local timeSince = tick() - State.LastTargetT
    if timeSince < Config.Trigger.StopDelay then
        if not State.IsFiring then
            State.IsFiring = true
            task.delay(Config.Trigger.ReactionTime, function()
                if State.Running and Config.Trigger.Enabled
                   and (tick() - State.LastTargetT) < (Config.Trigger.StopDelay + 0.1) then
                    pcall(InputManager.Press)
                else
                    State.IsFiring = false
                end
            end)
        end
    else
        if State.IsFiring then
            pcall(InputManager.Release)
            State.IsFiring = false
        end
    end
end

