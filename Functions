-- ║                              CLEANUP                                   ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
getgenv().AnyamiCleanup = function()
    State.Running = false

    for _, conn in ipairs(Connections) do
        pcall(function() conn:Disconnect() end)
    end
    Connections = {}

    if State.IsFiring then pcall(InputManager.Release) end
    if State.AutoFiring then pcall(InputManager.Release) end
    State.IsFiring = false
    State.AutoFiring = false

    if SilentAimConnection then SilentAimConnection:Disconnect() end

    pcall(function() FOVCircle:Remove() end)
    pcall(function() SilentFOVCircle:Remove() end)
    pcall(function() MagnetCircle:Remove() end)
    pcall(function() WatermarkText:Remove() end)
    pcall(function() DotCrosshair:Remove() end)
    for _, key in ipairs({"Name", "Info", "BarBg", "BarFill"}) do
        pcall(function() TgtInfo[key]:Remove() end)
    end
    for i = 1, 15 do pcall(function() OverlayLines[i]:Remove() end) end
    pcall(function() SnapLineObj:Remove() end)

    for plr, _ in pairs(ESPCache) do RemoveESP(plr) end

    for plr, sizes in pairs(OriginalSizes) do
        pcall(function()
            if plr.Character then
                if type(sizes) == "table" then
                    for name, size in pairs(sizes) do
                        local part = plr.Character:FindFirstChild(name)
                        if part and part:IsA("BasePart") then
                            part.Size = size
                            part.Transparency = 0
                            part.CanCollide = true
                        end
                    end
                elseif plr.Character:FindFirstChild("Head") then
                    plr.Character.Head.Size = sizes
                    plr.Character.Head.Transparency = 0
                    plr.Character.Head.CanCollide = true
                end
            end
        end)
    end
    OriginalSizes = {}

    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function()
            if p.Character and p.Character:FindFirstChild("AnyamiHL") then
                p.Character.AnyamiHL:Destroy()
            end
        end)
    end

    for part, original in pairs(WeaponChamsCache) do
        pcall(function()
            if part then part.Material = original end
            local glow = part:FindFirstChild("WeaponGlow")
            if glow then glow:Destroy() end
        end)
    end
    WeaponChamsCache = {}

    for part, original in pairs(ItemChamsCache) do
        pcall(function()
            if part then part.Material = original end
        end)
    end
    ItemChamsCache = {}

    if Config.Misc.Fullbright then SetFullbright(false) end

    if State.OriginalWalkSpeed then
        local char = LocalPlayer.Character
        if char then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = State.OriginalWalkSpeed end
        end
    end

    ResetRapidFire()

    getgenv().AnyamiCleanup = nil
end

