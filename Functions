TrackConnection(LocalPlayer.Idled:Connect(function()
    if Config.Misc.AntiAFK then
        pcall(function()
            local VU = game:GetService("VirtualUser")
            VU:CaptureController()
            VU:ClickButton2(Vector2.new())
        end)
    end
end))

TrackConnection(UserInputService.InputBegan:Connect(function(input)
    if Config.Misc.InfiniteJump and input.KeyCode == Enum.KeyCode.Space then
        local char = LocalPlayer.Character
        if char then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end
end))

TrackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if DoesInputMatch(input, Config.Visuals.ToggleBind) then
        Config.Visuals.Enabled = not Config.Visuals.Enabled
    end

    if DoesInputMatch(input, Config.Aimbot.Bind) then
        State.Aiming = true
    end

    if Config.Trigger.Mode == "Toggle" and DoesInputMatch(input, Config.Trigger.Bind) then
        State.ToggleState = not State.ToggleState
    end
end))

TrackConnection(UserInputService.InputEnded:Connect(function(input)
    if DoesInputMatch(input, Config.Aimbot.Bind) then
        State.Aiming = false
        State.AimTarget = nil
        if State.AutoFiring then
            pcall(InputManager.Release)
            State.AutoFiring = false
        end
    end
end))

