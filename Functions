            Library.Theme.AccentGradient = MenuCustomColor
        end
        if not Config.Aimbot.UseRainbowFOV then
            FOVCircle.Color = Config.Aimbot.FOVColor
        end
        if not Config.SilentAim.UseRainbowFOV then
            SilentFOVCircle.Color = Config.SilentAim.FOVColor
        end
    end

    local mp
    if Config.Aimbot.FOVOrigin == "Center" then
        local vp = Camera.ViewportSize
        mp = Vector2.new(vp.X / 2, vp.Y / 2)
    else
        mp = UserInputService:GetMouseLocation()
    end
    FOVCircle.Position = mp
    FOVCircle.Radius = Config.Aimbot.FOV
    FOVCircle.Visible = Config.Aimbot.Enabled and Config.Aimbot.ShowFOV
    
    SilentFOVCircle.Position = mp
