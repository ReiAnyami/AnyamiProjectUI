local function UpdateRainbowColor()
    local now = tick()
    local delta = (now - RainbowCore.LastUpdate) * RainbowCore.Speed * 2
    RainbowCore.LastUpdate = now
    
    if RainbowCore.Enabled then
        RainbowCore.Hue = (RainbowCore.Hue + delta) % 1
        local r, g, b = Color3.fromHSV(RainbowCore.Hue, 1, 1):ToRGB()
        RainbowCore.CurrentColor = Color3.fromRGB(r, g, b)
    end
    
    return RainbowCore.CurrentColor
end

local function GetRainbowColor()
    if not RainbowCore.Enabled then 
        return nil 
    end
    return RainbowCore.CurrentColor
end

