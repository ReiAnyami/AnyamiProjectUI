    pcall(UpdateTrigger)
    pcall(UpdateDrawingESP)
    pcall(UpdateCrosshair)
    pcall(UpdateWatermark)
    pcall(UpdateTargetInfo)
    pcall(UpdateKeybindOverlay)
    pcall(ApplyItemChams)
    pcall(ApplyWeaponChams)

    if Config.Aimbot.SnapLine and State.Aiming and State.CurrentTarget and IsAlive(State.CurrentTarget) then
        local bone = GetBone(State.CurrentTarget.Character, Config.Aimbot.Bone)
