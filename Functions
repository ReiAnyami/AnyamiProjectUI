            if vis then
                local center = Camera.ViewportSize / 2
                SnapLineObj.From = Vector2.new(center.X, center.Y)
                SnapLineObj.To = Vector2.new(pos.X, pos.Y)
                local isVis = CheckVisibility(State.CurrentTarget.Character, bone)
                SnapLineObj.Color = isVis and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
                SnapLineObj.Visible = true
            else
