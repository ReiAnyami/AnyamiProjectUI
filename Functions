-- ║                            ITEM CHAMS                                 ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local function ApplyItemChams()
    if not Config.ItemChams.Enabled then
        for part, original in pairs(ItemChamsCache) do
            pcall(function()
                if part then part.Material = original end
            end)
        end
        ItemChamsCache = {}
        return
    end

    local char = LocalPlayer.Character
    if not char then return end
    
    local chamsColor = (Config.ItemChams.UseRainbow and RainbowCore.Enabled) and RainbowCore.CurrentColor or Config.ItemChams.Color

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") and not ItemChamsCache[part] then
                    ItemChamsCache[part] = part.Material
                    part.Material = MaterialMap[Config.ItemChams.Material] or Enum.Material.Neon
                    part.Color = chamsColor
                    part.Transparency = Config.ItemChams.Transparency
                elseif part:IsA("BasePart") and ItemChamsCache[part] then
                    part.Material = MaterialMap[Config.ItemChams.Material] or Enum.Material.Neon
                    part.Color = chamsColor
