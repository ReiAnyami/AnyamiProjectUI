-- ║                          WEAPON CHAMS                                 ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local MaterialMap = {
    Neon = Enum.Material.Neon,
    Plastic = Enum.Material.Plastic,
    Metal = Enum.Material.Metal,
    Wood = Enum.Material.Wood,
    Glass = Enum.Material.Glass,
    SmoothPlastic = Enum.Material.SmoothPlastic,
}

local function ApplyWeaponChams()
    local char = LocalPlayer.Character
    if not char then
        for part, original in pairs(WeaponChamsCache) do
            pcall(function() if part then part.Material = original end end)
        end
        WeaponChamsCache = {}
        return
    end
    
    if not Config.WeaponChams.Enabled then
        for part, original in pairs(WeaponChamsCache) do
            pcall(function() if part then part.Material = original end end)
        end
        WeaponChamsCache = {}
        return
    end
    
    local chamsColor = (Config.WeaponChams.UseRainbow and RainbowCore.Enabled) and RainbowCore.CurrentColor or Config.WeaponChams.Color
    local targetMaterial = MaterialMap[Config.WeaponChams.Material] or Enum.Material.Neon
    
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") then
                    if not WeaponChamsCache[part] then
                        WeaponChamsCache[part] = part.Material
                    end
                    part.Material = targetMaterial
                    part.Color = chamsColor
                    part.Transparency = Config.WeaponChams.Transparency
                end
            end
        end
    end
end

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║                         AIMBOT (БЕЗ SMOOTH)                           ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local function AimAt(bone, character)
    if not bone then return end
    local targetPos = bone.Position
    
    if Config.Aimbot.Prediction > 0 then
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            local velocity = root.AssemblyLinearVelocity
            local distance = (targetPos - Camera.CFrame.Position).Magnitude
            local travelTime = distance / 3000
            targetPos = targetPos + (velocity * travelTime * Config.Aimbot.Prediction)
        end
    end
    
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
end

local function UpdateAimbot()
    if not Config.Aimbot.Enabled or not State.Aiming then
        State.AimTarget = nil
        if State.AutoFiring then
            pcall(InputManager.Release)
            State.AutoFiring = false
        end
        return
    end

    local mousePos = UserInputService:GetMouseLocation()
    local closest, minDist = nil, Config.Aimbot.FOV
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) and IsEnemyFor(plr, "Aimbot") and IsInRange(plr, Config.Aimbot.MaxDistance) then
            local bone = GetBone(plr.Character, Config.Aimbot.Bone)
            if bone then
                local pos, vis = Camera:WorldToViewportPoint(bone.Position)
                if vis then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = plr
                    end
                end
            end
        end
    end

    if closest then
        if Config.Aimbot.TargetLock then State.AimTarget = closest end
        local bone = GetBone(closest.Character, Config.Aimbot.Bone)
        AimAt(bone, closest.Character)
        if Config.Aimbot.AutoFire and not State.AutoFiring then
            State.AutoFiring = true
            pcall(InputManager.Press)
        end
    elseif State.AutoFiring then
        pcall(InputManager.Release)
        State.AutoFiring = false
    end
end

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║                      SILENT AIM (РАБОЧИЙ)                             ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local SilentAimConnection = nil

local function GetSilentTarget()
    if not Config.SilentAim.Enabled then return nil, nil end
    
    local mousePos = UserInputService:GetMouseLocation()
    local closest, minDist, closestPart = nil, Config.SilentAim.FOV, nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not IsAlive(plr) then continue end
        if not IsEnemyFor(plr, "SilentAim") then continue end
        if not IsInRange(plr, Config.SilentAim.MaxDistance) then continue end
        
        local bone = GetBone(plr.Character, Config.SilentAim.Bone)
        if not bone then continue end
        
        if Config.SilentAim.VisibleCheck or Config.SilentAim.WallCheck then
            if not CheckVisibility(plr.Character, bone) then continue end
        end
        
        local pos, vis = Camera:WorldToViewportPoint(bone.Position)
        if not vis then continue end
        
        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
        if dist < minDist then
            minDist = dist
            closest = plr
            closestPart = bone
        end
    end
    
    if closest and closestPart then
        local targetPos = closestPart.Position
        if Config.SilentAim.Prediction > 0 then
            local root = closest.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local velocity = root.AssemblyLinearVelocity
                local distance = (targetPos - Camera.CFrame.Position).Magnitude
                local travelTime = distance / 3000
                targetPos = targetPos + (velocity * travelTime * Config.SilentAim.Prediction)
            end
        end
        return closest, targetPos
    end
    return nil, nil
end

local function SetupSilentAim()
    if SilentAimConnection then
        SilentAimConnection:Disconnect()
        SilentAimConnection = nil
    end
    
    if not Config.SilentAim.Enabled then return end
    
    SilentAimConnection = RunService.RenderStepped:Connect(function()
        if not Config.SilentAim.Enabled then return end
        if not IsBindActive(Config.SilentAim.Bind) then return end
        
        if math.random() * 100 > Config.SilentAim.HitChance then return end
        
        local _, targetPos = GetSilentTarget()
        if targetPos then
            local screenPoint = Camera:WorldToViewportPoint(targetPos)
            if screenPoint.Z > 0 then
                mousemoveabs(screenPoint.X, screenPoint.Y)
            end
        end
    end)
end

-- ╔═══════════════════════════════════════════════════════════════════════╗
-- ║                            TRIGGERBOT                                 ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local function UpdateTrigger()
    MagnetCircle.Visible = Config.Trigger.Enabled
    MagnetCircle.Position = UserInputService:GetMouseLocation()
    MagnetCircle.Radius = Config.Trigger.MagnetRadius

    if not Config.Trigger.Enabled then
        if State.IsFiring then
            pcall(InputManager.Release)
            State.IsFiring = false
        end
        return
    end

    local isActive = (Config.Trigger.Mode == "Hold" and IsBindActive(Config.Trigger.Bind)) or State.ToggleState

    if not isActive then
        if State.IsFiring then
            pcall(InputManager.Release)
            State.IsFiring = false
        end
        return
    end

    local mousePos = UserInputService:GetMouseLocation()
    State.LastTargetT = tick() - Config.Trigger.StopDelay - 1

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsAlive(plr) and IsEnemyFor(plr, "Trigger") then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist <= Config.Trigger.MagnetRadius then
                        if CheckVisibility(plr.Character, head) then
                            State.LastTargetT = tick()
                            break
                        end
                    end
                end
            end
        end
    end

    local timeSince = tick() - State.LastTargetT
    if timeSince < Config.Trigger.StopDelay then
        if not State.IsFiring then
            State.IsFiring = true
            task.delay(Config.Trigger.ReactionTime, function()
                if State.Running and Config.Trigger.Enabled and (tick() - State.LastTargetT) < (Config.Trigger.StopDelay + 0.1) then
                    pcall(InputManager.Press)
                end
            end)
        end
    elseif State.IsFiring then
        pcall(InputManager.Release)
        State.IsFiring = false
    end
end

