        TgtInfo.BarBg.Visible = false
        TgtInfo.BarFill.Visible = false
        return
    end

    local vp = Camera.ViewportSize
    if vp.X == 0 or vp.Y == 0 then return end
    local cx = vp.X / 2
    local baseY = vp.Y / 2 + 50

    TgtInfo.Name.Text = target.DisplayName
    TgtInfo.Name.Position = Vector2.new(cx, baseY)
    TgtInfo.Name.Visible = true

    local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
    local hp = math.floor(humanoid.Health)
    local maxHp = math.floor(humanoid.MaxHealth)
    local weapon = "None"
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            weapon = tool.Name
            break
        end
    end

    TgtInfo.Info.Text = string.format("%d/%d HP | %dm | %s", hp, maxHp, dist, weapon)
    TgtInfo.Info.Position = Vector2.new(cx, baseY + 16)
    TgtInfo.Info.Visible = true

    local barW = 120
    local barX = cx - barW / 2
    local barY = baseY + 34
    local hpFrac = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)

    TgtInfo.BarBg.From = Vector2.new(barX, barY)
    TgtInfo.BarBg.To = Vector2.new(barX + barW, barY)
    TgtInfo.BarBg.Visible = true
    TgtInfo.BarFill.From = Vector2.new(barX, barY)
    TgtInfo.BarFill.To = Vector2.new(barX + barW * hpFrac, barY)
    TgtInfo.BarFill.Color = Color3.fromRGB(255 * (1 - hpFrac), 255 * hpFrac, 0)
    TgtInfo.BarFill.Visible = true
end

