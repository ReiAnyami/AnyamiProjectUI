local function UpdateKeybindOverlay()
    if not Config.Misc.KeybindOverlay then
        for i = 1, 15 do
            if OverlayLines[i] then OverlayLines[i].Visible = false end
        end
        return
    end
    
    local viewport = Camera.ViewportSize
    local startY = 10
    local lineHeight = 16
    local lineNum = 1
    
    local function addLine(text, color)
        if lineNum > 15 then return end
        OverlayLines[lineNum].Text = text
        OverlayLines[lineNum].Color = color or Color3.fromRGB(255, 255, 255)
        OverlayLines[lineNum].Position = Vector2.new(10, startY + (lineNum - 1) * lineHeight)
        OverlayLines[lineNum].Visible = true
        lineNum = lineNum + 1
    end
    
    local aimbotKey = BindName(Config.Aimbot.Bind)
    local aimbotStatus = State.Aiming and "[ACTIVE]" or "[HOLD]"
    local aimbotColor = State.Aiming and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 200, 100)
    addLine(string.format("Aimbot: %s %s", aimbotKey, aimbotStatus), aimbotColor)
    
    local silentKey = BindName(Config.SilentAim.Bind)
    local silentStatus = Config.SilentAim.Enabled and IsBindActive(Config.SilentAim.Bind) and "[ACTIVE]" or (Config.SilentAim.Enabled and "[READY]" or "[OFF]")
    local silentColor = (Config.SilentAim.Enabled and IsBindActive(Config.SilentAim.Bind)) and Color3.fromRGB(100, 255, 100) or (Config.SilentAim.Enabled and Color3.fromRGB(255, 200, 100) or Color3.fromRGB(255, 100, 100))
    addLine(string.format("Silent: %s %s", silentKey, silentStatus), silentColor)
    
    local triggerKey = BindName(Config.Trigger.Bind)
    local triggerStatus = ""
    if Config.Trigger.Mode == "Hold" then
        triggerStatus = IsBindActive(Config.Trigger.Bind) and "[ACTIVE]" or "[HOLD]"
    else
        triggerStatus = State.ToggleState and "[ON]" or "[OFF]"
    end
    local triggerColor = ((Config.Trigger.Mode == "Hold" and IsBindActive(Config.Trigger.Bind)) or 
                         (Config.Trigger.Mode == "Toggle" and State.ToggleState)) and 
                         Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 200, 100)
    addLine(string.format("Trigger: %s %s", triggerKey, triggerStatus), triggerColor)
    
    local espKey = BindName(Config.Visuals.ToggleBind)
    local espStatus = Config.Visuals.Enabled and "[ON]" or "[OFF]"
    local espColor = Config.Visuals.Enabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    addLine(string.format("ESP: %s %s", espKey, espStatus), espColor)
    
    local weaponChamsStatus = Config.WeaponChams.Enabled and "[ON]" or "[OFF]"
    local weaponChamsColor = Config.WeaponChams.Enabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    addLine(string.format("Weapon Chams: %s", weaponChamsStatus), weaponChamsColor)
    
    if Config.Crosshair.Enabled then
        addLine(string.format("Crosshair: [ON]", Color3.fromRGB(100, 200, 255)))
    end
    
    if RainbowCore.Enabled then
        addLine(string.format("RAINBOW MODE", Color3.fromRGB(255, 100, 255)))
    end
    
    for i = lineNum, 15 do
        if OverlayLines[i] then OverlayLines[i].Visible = false end
    end
end

