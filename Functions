-- ║                          WEAPON CHAMS                                 ║
-- ╚═══════════════════════════════════════════════════════════════════════╝
local MaterialMap = {
    Neon = Enum.Material.Neon,
    Plastic = Enum.Material.Plastic,
    Metal = Enum.Material.Metal,
    Wood = Enum.Material.Wood,
    Stone = Enum.Material.Slate,
    Glass = Enum.Material.Glass,
    SmoothPlastic = Enum.Material.SmoothPlastic,
    Ice = Enum.Material.Ice,
    ForceField = Enum.Material.ForceField,
}

local function ApplyWeaponChams()
    local char = LocalPlayer.Character
    if not char then
        for part, original in pairs(WeaponChamsCache) do
            pcall(function()
                if part then part.Material = original end
                local glow = part:FindFirstChild("WeaponGlow")
                if glow then glow:Destroy() end
            end)
        end
        WeaponChamsCache = {}
        return
    end
    
    if not Config.WeaponChams.Enabled then
        for part, original in pairs(WeaponChamsCache) do
            pcall(function()
                if part then part.Material = original end
                local glow = part:FindFirstChild("WeaponGlow")
                if glow then glow:Destroy() end
            end)
        end
        WeaponChamsCache = {}
        return
    end
    
    local chamsColor = (Config.WeaponChams.UseRainbow and RainbowCore.Enabled) and RainbowCore.CurrentColor or Config.WeaponChams.Color
    local targetMaterial = MaterialMap[Config.WeaponChams.Material] or Enum.Material.Neon
    
    local tools = {}
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            table.insert(tools, child)
        end
    end
    
    local arms = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if arms then
        for _, child in ipairs(arms:GetChildren()) do
            if child:IsA("Tool") or (child:IsA("BasePart") and child.Name:lower():find("arm")) then
                table.insert(tools, child)
            end
        end
    end
    
    for _, tool in ipairs(tools) do
        for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then
                if not WeaponChamsCache[part] then
                    WeaponChamsCache[part] = part.Material
                end
                
                part.Material = targetMaterial
                part.Color = chamsColor
                part.Transparency = Config.WeaponChams.Transparency
                
                if Config.WeaponChams.GlowEffect then
                    local glow = part:FindFirstChild("WeaponGlow")
                    if not glow then
                        glow = Instance.new("BillboardGui")
                        glow.Name = "WeaponGlow"
                        glow.AlwaysOnTop = true
                        glow.LightInfluence = 0
                        glow.Size = UDim2.new(2, 0, 2, 0)
                        glow.ExtentsOffsetWorldSpace = Vector3.new(0, 0, 0)
                        
                        local frame = Instance.new("Frame")
                        frame.Size = UDim2.new(1, 0, 1, 0)
                        frame.BackgroundTransparency = 0.5
                        frame.BackgroundColor3 = chamsColor
                        frame.BorderSizePixel = 0
                        frame.Parent = glow
                        
                        local uiCorner = Instance.new("UICorner")
                        uiCorner.CornerRadius = UDim.new(1, 0)
                        uiCorner.Parent = frame
                        
                        glow.Parent = part
                    else
                        local frame = glow:FindFirstChildOfClass("Frame")
                        if frame then
                            frame.BackgroundColor3 = chamsColor
                            frame.BackgroundTransparency = math.max(0.3, Config.WeaponChams.Transparency)
                        end
                    end
                else
                    local glow = part:FindFirstChild("WeaponGlow")
                    if glow then glow:Destroy() end
                end
            end
        end
    end
    
    for part, _ in pairs(WeaponChamsCache) do
        if not part.Parent or not part:IsDescendantOf(char) then
            pcall(function()
                if part then part.Material = WeaponChamsCache[part] end
                local glow = part:FindFirstChild("WeaponGlow")
                if glow then glow:Destroy() end
            end)
            WeaponChamsCache[part] = nil
        end
    end
end

