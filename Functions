local RainbowState = {
    Enabled = false,
    Hue = 0,
    Speed = 0.5,
    LastTime = tick(),
}

local function GetRainbowColor()
    local now = tick()
    local delta = math.min(0.1, now - RainbowState.LastTime)
    RainbowState.LastTime = now
    RainbowState.Hue = (RainbowState.Hue + RainbowState.Speed * delta) % 1
    return Color3.fromHSV(RainbowState.Hue, 1, 1)
end

