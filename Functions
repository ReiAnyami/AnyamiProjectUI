-- ║     [15]  CORE: SWASTIKA CROSSHAIR      ║
-- ╚══════════════════════════════════════════╝
local swastikaLastTime = tick()

local function UpdateSwastikaCrosshair()
    local viewport = Camera.ViewportSize
    if viewport.X == 0 or viewport.Y == 0 then return end
    
    local center = viewport / 2
    local cx, cy = center.X, center.Y
    local armLength = Config.Crosshair.Size
    local hookLength = Config.Crosshair.HookLength
    local thick = Config.Crosshair.Thickness
    
    local crosshairColor = Config.Crosshair.Rainbow and GetRainbowColor() or Config.Crosshair.Color
    
    for i = 1, 8 do
        SwastikaLines[i].Thickness = thick
        SwastikaLines[i].Color = crosshairColor
    end
    
    local now = tick()
    local deltaTime = math.min(0.033, now - swastikaLastTime)
    swastikaLastTime = now
    
    Config.Crosshair.SwastikaAngle = (Config.Crosshair.SwastikaAngle or 0) + Config.Crosshair.RotationSpeed * deltaTime
    if Config.Crosshair.SwastikaAngle >= 360 then Config.Crosshair.SwastikaAngle = Config.Crosshair.SwastikaAngle - 360 end
    
    local rad = math.rad(Config.Crosshair.SwastikaAngle)
    local cosA = math.cos(rad)
    local sinA = math.sin(rad)
    
    local directions = {
        {dx = 0,  dy = -1},
        {dx = 1,  dy = 0},
        {dx = 0,  dy = 1},
        {dx = -1, dy = 0}
    }
    
    local hookDirs = {
        {hx = 1,  hy = 0},
        {hx = 0,  hy = 1},
        {hx = -1, hy = 0},
        {hx = 0,  hy = -1}
    }
    
    for i = 1, 4 do
        local dir = directions[i]
        local mainEnd = Vector2.new(dir.dx * armLength, dir.dy * armLength)
        
        local rotatedEndX = mainEnd.X * cosA - mainEnd.Y * sinA
        local rotatedEndY = mainEnd.X * sinA + mainEnd.Y * cosA
        local rotatedEnd = Vector2.new(rotatedEndX, rotatedEndY)
        
        SwastikaLines[i*2 - 1].From = Vector2.new(cx, cy)
        SwastikaLines[i*2 - 1].To = Vector2.new(cx + rotatedEnd.X, cy + rotatedEnd.Y)
        
        local hookDir = hookDirs[i]
        local hookVec = Vector2.new(hookDir.hx * hookLength, hookDir.hy * hookLength)
        
        local rotatedHookX = hookVec.X * cosA - hookVec.Y * sinA
        local rotatedHookY = hookVec.X * sinA + hookVec.Y * cosA
        local rotatedHook = Vector2.new(rotatedHookX, rotatedHookY)
        
        SwastikaLines[i*2].From = Vector2.new(cx + rotatedEnd.X, cy + rotatedEnd.Y)
        SwastikaLines[i*2].To = Vector2.new(cx + rotatedEnd.X + rotatedHook.X, cy + rotatedEnd.Y + rotatedHook.Y)
    end
    
    for i = 1, 8 do SwastikaLines[i].Visible = true end
end

